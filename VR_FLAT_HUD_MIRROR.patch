+// Centered rect of an eyeW x eyeH image with the window's aspect ratio.
+struct MirrorCrop {
+    uint32_t x = 0, y = 0, width = 0, height = 0;
+};
+inline bool computeMirrorCrop(uint32_t eyeW, uint32_t eyeH, uint32_t windowWidth, uint32_t windowHeight,
+                              MirrorCrop& out) {
+    if (eyeW == 0 || eyeH == 0 || windowWidth == 0 || windowHeight == 0) {
+        return false;
+    }
+    const double windowAspect = static_cast<double>(windowWidth) / static_cast<double>(windowHeight);
+    uint32_t w = eyeW;
+    uint32_t h = eyeH;
+    if (static_cast<double>(eyeW) / eyeH > windowAspect) {
+        w = static_cast<uint32_t>(std::lround(eyeH * windowAspect));
+    } else {
+        h = static_cast<uint32_t>(std::lround(eyeW / windowAspect));
+    }
+    out.width = std::clamp<uint32_t>(w, 1, eyeW);
+    out.height = std::clamp<uint32_t>(h, 1, eyeH);
+    out.x = (eyeW - out.width) / 2;
+    out.y = (eyeH - out.height) / 2;
+    return true;
+}
