+// ---------------------------------------------------------------------------
+// Desktop mirror with a flat HUD ("Flat HUD in Window", game.vrMirrorFlatHud,
+// 2026-11-11)
+// ---------------------------------------------------------------------------
+//
+// The mirror is a copy of the left eye, so it used to show the VR HUD panel
+// floating in 3D wherever the left eye saw it. With this on, the window gets
+// the HUD flat over the whole image instead, like flatscreen, and the headset
+// keeps its panel:
+//  1. captureMirrorEyeBeforeHud(): an ordinary GXCopyTex of the left eye,
+//     taken inside the eye pass right before the HUD panel is drawn
+//     (mDoGph_Painter()'s HUD call site). aurora splits the protected eye
+//     pass for it and the eye carries on (see resolve_pass_into()). The copy
+//     comes out at the eye's real resolution, and under single-pass stereo
+//     copy_tex() already takes just the left half.
+//  2. composeMirrorWithFlatHud(): after the eye passes, a small offscreen
+//     pass at the window's aspect draws that copy (cropped like
+//     cropMirrorToSingleEye()) and then the captured HUD texture over all of
+//     it with the panel's own luma key (setHudLumaKeyTevStages()), so it
+//     looks the same as in the headset. Its resolve becomes the mirror.
+// The VR menu panel and the aim dot are drawn after the capture, so they
+// don't appear in the window either (RmlUi already draws the menu there).
+inline u8 g_mirrorEyeCopyKey[4]{};
+inline TGXTexObj g_mirrorEyeTexObj{};
+inline bool g_mirrorEyeCaptured = false;
+
+inline void captureMirrorEyeBeforeHud() {
+    GXSetTexCopySrc(0, 0, FB_WIDTH, FB_HEIGHT);
+    GXSetTexCopyDst(FB_WIDTH, FB_HEIGHT, GX_TF_RGBA8, GX_FALSE);
+    GXCopyTex(g_mirrorEyeCopyKey, GX_FALSE);
+    GXPixModeSync();
+    GXInvalidateTexAll();
+    g_mirrorEyeCaptured = true;
+}
+
+// eyeW/eyeH: one eye's resolution (the capture's size). False if there's no
+// capture this frame or the pass can't open; the caller then falls back to
+// the plain mirror. Must run with no offscreen pass open.
+inline bool composeMirrorWithFlatHud(TGXTexObj* hudTex, uint32_t eyeW, uint32_t eyeH, uint32_t windowWidth,
+                                     uint32_t windowHeight, aurora::gfx::ResolvedTargets& out) {
+    if (!g_mirrorEyeCaptured || hudTex == nullptr) {
+        return false;
+    }
+    g_mirrorEyeCaptured = false;
+    MirrorCrop crop;
+    if (!computeMirrorCrop(eyeW, eyeH, windowWidth, windowHeight, crop)) {
+        return false;
+    }
+    const float w = static_cast<float>(crop.width);
+    const float h = static_cast<float>(crop.height);
+    const float u0 = static_cast<float>(crop.x) / eyeW;
+    const float v0 = static_cast<float>(crop.y) / eyeH;
+    const float u1 = static_cast<float>(crop.x + crop.width) / eyeW;
+    const float v1 = static_cast<float>(crop.y + crop.height) / eyeH;
+
+    // Same texture-object setup the HUD capture uses (FB-sized; aurora
+    // resolves the key to the real, eye-resolution copy).
+    GXInitTexObj(&g_mirrorEyeTexObj, g_mirrorEyeCopyKey, FB_WIDTH, FB_HEIGHT, GX_TF_RGBA8, GX_CLAMP, GX_CLAMP,
+                 GX_FALSE);
+
+    if (!aurora::gfx::create_pass(crop.width, crop.height)) {
+        return false;
+    }
+    const uint64_t passId = aurora::gfx::current_pass_id();
+
+    Mtx44 projection;
+    C_MTXOrtho(projection, 0.0f, h, 0.0f, w, 0.0f, -1.0f);
+    GXSetProjection(projection, GX_ORTHOGRAPHIC);
+    GXLoadPosMtxImm(cMtx_getIdentity(), GX_PNMTX0);
+    GXSetCurrentMtx(GX_PNMTX0);
+    GXSetViewport(0.0f, 0.0f, w, h, 0.0f, 1.0f);
+    GXSetScissor(0, 0, crop.width, crop.height);
+    GXClearVtxDesc();
+    GXSetVtxDesc(GX_VA_POS, GX_DIRECT);
+    GXSetVtxDesc(GX_VA_TEX0, GX_DIRECT);
+    GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_POS, GX_POS_XYZ, GX_F32, 0);
+    GXSetVtxAttrFmt(GX_VTXFMT0, GX_VA_TEX0, GX_TEX_ST, GX_F32, 0);
+    GXSetNumChans(0);
+    GXSetNumTexGens(1);
+    GXSetTexCoordGen(GX_TEXCOORD0, GX_TG_MTX2x4, GX_TG_TEX0, 0x3C);
+    GXSetZMode(GX_DISABLE, GX_ALWAYS, GX_DISABLE);
+    GXSetCullMode(GX_CULL_NONE);
+    GXSetAlphaCompare(GX_ALWAYS, 0, GX_AOP_OR, GX_ALWAYS, 0);
+
+    // The eye, opaque.
+    GXSetNumTevStages(1);
+    GXSetTevOrder(GX_TEVSTAGE0, GX_TEXCOORD0, GX_TEXMAP0, GX_COLOR_NULL);
+    GXSetTevSwapMode(GX_TEVSTAGE0, GX_TEV_SWAP0, GX_TEV_SWAP0);
+    GXSetTevColorIn(GX_TEVSTAGE0, GX_CC_ZERO, GX_CC_ZERO, GX_CC_ZERO, GX_CC_TEXC);
+    GXSetTevColorOp(GX_TEVSTAGE0, GX_TEV_ADD, GX_TB_ZERO, GX_CS_SCALE_1, GX_TRUE, GX_TEVPREV);
+    GXSetTevAlphaIn(GX_TEVSTAGE0, GX_CA_ZERO, GX_CA_ZERO, GX_CA_ZERO, GX_CA_TEXA);
+    GXSetTevAlphaOp(GX_TEVSTAGE0, GX_TEV_ADD, GX_TB_ZERO, GX_CS_SCALE_1, GX_TRUE, GX_TEVPREV);
+    GXSetBlendMode(GX_BM_NONE, GX_BL_ONE, GX_BL_ZERO, GX_LO_SET);
+    GXLoadTexObj(&g_mirrorEyeTexObj, GX_TEXMAP0);
+    GXBegin(GX_QUADS, GX_VTXFMT0, 4);
+    GXPosition3f32(0.0f, 0.0f, 0.0f); GXTexCoord2f32(u0, v0);
+    GXPosition3f32(w, 0.0f, 0.0f); GXTexCoord2f32(u1, v0);
+    GXPosition3f32(w, h, 0.0f); GXTexCoord2f32(u1, v1);
+    GXPosition3f32(0.0f, h, 0.0f); GXTexCoord2f32(u0, v1);
+    GXEnd();
+
+    // The HUD over the whole window, keyed exactly like the VR panel.
+    GXSetNumTevStages(3);
+    setHudLumaKeyTevStages();
+    GXSetBlendMode(GX_BM_BLEND, GX_BL_SRCALPHA, GX_BL_INVSRCALPHA, GX_LO_SET);
+    GXLoadTexObj(hudTex, GX_TEXMAP0);
+    GXBegin(GX_QUADS, GX_VTXFMT0, 4);
+    GXPosition3f32(0.0f, 0.0f, 0.0f); GXTexCoord2f32(0.0f, 0.0f);
+    GXPosition3f32(w, 0.0f, 0.0f); GXTexCoord2f32(1.0f, 0.0f);
+    GXPosition3f32(w, h, 0.0f); GXTexCoord2f32(1.0f, 1.0f);
+    GXPosition3f32(0.0f, h, 0.0f); GXTexCoord2f32(0.0f, 1.0f);
+    GXEnd();
+
+    aurora::gfx::ResolvedTargets targets;
+    if (!aurora::gfx::resolve_pass_checked({.color = true}, targets, passId) || !targets.colorTexture) {
+        return false;
+    }
+    out = targets;
+    return true;
+}
